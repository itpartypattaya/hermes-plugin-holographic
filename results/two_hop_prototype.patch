+    def hop_candidates(self, query: str, seeds: list[dict], *, named: set[int], exclude: set[int], min_trust: float,
+                       bridges: int, hub_cap: int) -> list[dict]:
+        """Two-hop links (``two_hop``): current facts one entity further than *seeds* that hold a word of *query* no
+        seed holds, best first. "Who is responsible for the server Alpha runs on?": the seed says Alpha runs on
+        vega-01, the hop finds who is responsible for vega-01 though the question never names it.
+
+        Bridges are the entities linked to the seeds, in the seeds' order, minus the ones the message names (*named*)
+        and minus hubs (more than *hub_cap* linked facts: the user, the company); at most *bridges* of them. Only the
+        ``fact_entities`` join of current facts is walked, the one probe uses: a forgotten, ended, merged or replaced
+        version is not there, and one store file is one scope. Each candidate carries ``via``, the seed it hangs on.
+        Ranked by how many missing words it holds, then trust. Nothing when the seeds already hold every word."""
+        terms = [t for t in query_terms(_RE_UNSEGMENTED.sub(" ", query or "")) if t.word]
+        if not seeds or not terms or bridges <= 0:
+            return []
+        seed_texts = [analyze(_fact_text(f)) for f in seeds]
+        missing = [t for t in terms if not any(t.found_in(a) for a in seed_texts)]
+        if not missing:
+            return []
+        seed_ids = [f["fact_id"] for f in seeds]
+        rank = {fact_id: i for i, fact_id in enumerate(seed_ids)}
+        links = self.store.read(f"SELECT fact_id, entity_id FROM fact_entities WHERE fact_id IN "
+                                f"({','.join('?' * len(seed_ids))})", seed_ids)
+        via: dict[int, int] = {}
+        for fact_id, entity_id in sorted(((r[0], r[1]) for r in links), key=lambda p: (rank[p[0]], p[1])):
+            if entity_id not in named:
+                via.setdefault(entity_id, fact_id)
+        if not via:
+            return []
+        sizes = {r[0]: r[1] for r in self.store.read(
+            f"SELECT entity_id, COUNT(*) FROM fact_entities WHERE entity_id IN ({','.join('?' * len(via))}) "
+            "GROUP BY entity_id", list(via))}
+        walked = [e for e in via if sizes.get(e, 0) <= hub_cap][:bridges]
+        found: dict[int, tuple] = {}
+        for entity_id in walked:
+            for fact in self._linked_facts([[entity_id]], None, min_trust, hub_cap):
+                fact_id = fact["fact_id"]
+                if fact_id in exclude or fact_id in rank or fact_id in found:
+                    continue
+                analysis = analyze(_fact_text(fact))
+                held = sum(1 for t in missing if t.found_in(analysis))
+                if held:
+                    fact["via"] = via[entity_id]
+                    found[fact_id] = (-held, -fact["trust_score"], fact_id, fact)
+        return [entry[3] for entry in sorted(found.values(), key=lambda e: e[:3])]
+
